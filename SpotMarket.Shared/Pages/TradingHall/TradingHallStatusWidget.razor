@inject ITradingMarketInfoService HallService

@* ساعت کار تالار و وضعیت باز/بسته از این ویجت برداشته شد.

   دلیل: هیچ‌کدام داده نبودند. سرویس دامنه آن‌ها را ثابت می‌نوشت — وضعیت همیشه «باز»، شروع
   همیشه ۱۰:۳۰ و پایان همیشه ۱۷:۰۰ — و جدول TradingHalls اصلاً ستونی برای ساعت یا وضعیت
   ندارد. تنها جایی که این اطلاعات را داشت جدول TradingMarketInfo بود که در محیط واقعی
   خالی است. پس ویجت ساعت سه بامدادِ جمعه هم «باز، تا ۱۷:۰۰» نشان می‌داد.

   «در حال معامله» هم به همین دلیل حذف شد: در سرویس یادداشت شده که محاسبه‌اش به داده‌ی
   لحظه‌ای نیاز دارد که وجود ندارد، و همیشه صفر برمی‌گشت.

   اگر روزی منبع واقعی این داده‌ها فراهم شد (پر شدن TradingMarketInfo یا اتصال هاب)، این
   بخش را با همان داده برگردانید — نه با مقدار ثابت. *@

@if (_isLoading)
{
    <div class="status-widget-placeholder"></div>
}
else if (_data != null)
{
    <div class="status-widget">
        <!-- Offer Stats Section -->
        <div class="offers-stats-header">
            <span class="header-title">@_offersTitle</span>
            <span class="total-value">@_data.TotalOffers عرضه</span>
        </div>
        <div class="progress-bar flex-row">
            <div class="progress-segment traded" style="width: @(_tradedPercentage)%" title="معامله شده: @_data.TradedOffers"></div>
            <div class="progress-segment remaining" style="width: @(_remainingPercentage)%" title="@_remainingLabel: @_data.RemainingOffers"></div>
        </div>
        <div class="progress-legend">
            <div class="legend-item"><span class="dot traded"></span>معامله شده (@_data.TradedOffers)</div>
            <div class="legend-item"><span class="dot remaining"></span>@_remainingLabel (@_data.RemainingOffers)</div>
        </div>
    </div>
}


@code {
    [Parameter] public int MarketId { get; set; }
    private bool _isLoading = true;
    private HallStatusData? _data;

    private double _tradedPercentage = 0;
    private double _remainingPercentage = 0;

    // سرور «روز مؤثر» را برمی‌گرداند نه لزوماً امروز: در تعطیلات و آخر هفته ارقام مربوط به
    // آخرین روز معاملاتی است. عنوان ثابتِ «امروز» در آن روزها دروغ می‌شد.
    private string _offersTitle = "آمار عرضه‌ها";

    // پیش‌تر این برچسب با مقایسه‌ی ساعتِ جاری با ساعت کارِ ثابتِ تالار انتخاب می‌شد. حالا که
    // ساعت کار داده‌ی واقعی نیست، معیار درست همان روز است: اگر داده مربوط به امروز نباشد،
    // آن روز تمام شده و باقی‌مانده‌ها قطعاً «معامله نشده»اند.
    private string _remainingLabel = "معامله نشده";

    protected override async Task OnInitializedAsync()
    {
        _data = await HallService.GetStatusDataAsync(MarketId);

        if (_data != null)
        {
            var isToday = _data.IsForToday || string.IsNullOrWhiteSpace(_data.EffectiveDate);

            _offersTitle = isToday
                ? "آمار عرضه‌های امروز"
                : $"آمار عرضه‌های {_data.EffectiveDate}";

            _remainingLabel = isToday ? "باقی‌مانده" : "معامله نشده";
        }

        if (_data != null && _data.TotalOffers > 0)
        {
            _tradedPercentage = (double)_data.TradedOffers / _data.TotalOffers * 100;
            _remainingPercentage = (double)_data.RemainingOffers / _data.TotalOffers * 100;
        }
        _isLoading = false;
    }
}
