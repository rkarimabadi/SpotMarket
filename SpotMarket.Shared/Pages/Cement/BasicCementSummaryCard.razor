@inject ICementService CementService
@implements IDisposable
<div class="market-summary-card">
    <h2 class="summary-title">نبض بازار امروز</h2>
    <div class="summary-value">
        @data?.Value
    </div>
    <p class="summary-label">@data?.Label</p>
    <p class="summary-subtitle">@data?.Subtitle</p>
</div>

@code {
    private BasicCementMarketSummary? data;
    private CancellationTokenSource _cts = new();
    protected override async Task OnInitializedAsync()
    {
        data = await CementService.GetBasicCementMarketSummaryDataAsync(_cts.Token);
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
